# Ignore Python cache files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore virtual environments
.venv/
venv/
env/

# Ignore build and tool caches
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
output/
sessions/
node_modules/

# Local environment config. Holds only PYTHONPATH today (VS Code reads
# it), but an untracked .env is the norm — this repo now drives a
# deployment, and a credential landing here must not reach git.
.env

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore local output files
.output/*
*.pkl
*.txt
*.log
*.csv
*.png